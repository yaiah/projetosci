<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Oficina de Validação da Justificativa</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root, [data-theme="light"] {
      --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
      --text-sm: clamp(0.875rem, 0.8rem + 0.35vw, 1rem);
      --text-base: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
      --text-lg: clamp(1.125rem, 1rem + 0.75vw, 1.5rem);
      --text-xl: clamp(1.5rem, 1.2rem + 1.25vw, 2.25rem);
      --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem; --space-4: 1rem;
      --space-5: 1.25rem; --space-6: 1.5rem; --space-8: 2rem; --space-10: 2.5rem;
      --space-12: 3rem; --space-16: 4rem;
      --color-bg: #f7f6f2; --color-surface: #f9f8f5; --color-surface-2: #fbfbf9;
      --color-surface-offset: #edeae5; --color-border: #d4d1ca; --color-divider: #dcd9d5;
      --color-text: #28251d; --color-text-muted: #65635d; --color-text-faint: #8d8a84;
      --color-primary: #01696f; --color-primary-hover: #0c4e54; --color-primary-highlight: #cedcd8;
      --color-success: #437a22; --color-warning: #964219; --color-blue: #006494;
      --shadow-sm: 0 1px 2px rgba(40,37,29,0.06); --shadow-md: 0 6px 18px rgba(40,37,29,0.08);
      --radius-sm: 0.375rem; --radius-md: 0.75rem; --radius-lg: 1rem; --radius-full: 9999px;
      --font-display: 'Instrument Serif', Georgia, serif; --font-body: 'Work Sans', Arial, sans-serif;
      --content: 72rem;
    }
    [data-theme="dark"] {
      --color-bg: #171614; --color-surface: #1c1b19; --color-surface-2: #201f1d;
      --color-surface-offset: #22211f; --color-border: #393836; --color-divider: #262523;
      --color-text: #e3e1dd; --color-text-muted: #b5b2ac; --color-text-faint: #918f89;
      --color-primary: #4f98a3; --color-primary-hover: #227f8b; --color-primary-highlight: #313b3b;
      --color-success: #6daa45; --color-warning: #bb653b; --color-blue: #5591c7;
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.2); --shadow-md: 0 8px 24px rgba(0,0,0,0.32);
    }
    *,:before,:after{box-sizing:border-box;margin:0;padding:0}
    html{-webkit-text-size-adjust:none;text-size-adjust:none;scroll-behavior:smooth}
    body{min-height:100dvh;font-family:var(--font-body);font-size:var(--text-base);line-height:1.65;background:var(--color-bg);color:var(--color-text)}
    img,svg{display:block;max-width:100%;height:auto}
    a{color:var(--color-primary)}
    button{font:inherit;cursor:pointer;border:none;background:none}
    h1,h2,h3{line-height:1.12;text-wrap:balance}
    p,li{max-width:72ch;text-wrap:pretty}
    .skip-link{position:absolute;left:-9999px;top:auto}.skip-link:focus{left:var(--space-4);top:var(--space-4);background:var(--color-primary);color:#fff;padding:var(--space-3) var(--space-4);border-radius:var(--radius-sm);z-index:1000}
    .shell{max-width:var(--content);margin:0 auto;padding:0 var(--space-4)}
    .topbar{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);background:color-mix(in srgb, var(--color-bg) 84%, transparent);border-bottom:1px solid var(--color-divider)}
    .topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);padding:var(--space-4) 0}
    .brand{display:flex;align-items:center;gap:var(--space-3);font-size:var(--text-sm);font-weight:600;color:var(--color-text);text-decoration:none}
    .brand svg{width:2rem;height:2rem;color:var(--color-primary)}
    .theme-toggle{min-width:44px;min-height:44px;display:grid;place-items:center;border:1px solid var(--color-border);border-radius:var(--radius-full);background:var(--color-surface);box-shadow:var(--shadow-sm)}
    .hero{padding:clamp(var(--space-8), 8vw, var(--space-16)) 0 var(--space-8)}
    .hero-card{background:linear-gradient(180deg,var(--color-surface),var(--color-surface-2));border:1px solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:clamp(var(--space-6),5vw,var(--space-10));display:grid;gap:var(--space-6)}
    .eyebrow{display:inline-flex;align-items:center;gap:var(--space-2);padding:var(--space-2) var(--space-3);border-radius:var(--radius-full);background:var(--color-primary-highlight);color:var(--color-primary);font-size:var(--text-xs);font-weight:700;letter-spacing:.04em;text-transform:uppercase}
    h1{font-family:var(--font-display);font-size:var(--text-xl);font-weight:400}
    .lead{font-size:clamp(1rem,0.96rem + .5vw,1.25rem);color:var(--color-text-muted)}
    .meta{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:var(--space-4)}
    .meta-card{background:var(--color-bg);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:var(--space-4)}
    .meta-card strong{display:block;font-size:var(--text-sm);margin-bottom:var(--space-1)}
    main{padding-bottom:var(--space-16)}
    .grid{display:grid;gap:var(--space-6)}
    @media (min-width: 860px){.grid{grid-template-columns:1.1fr .9fr;align-items:start}}
    .panel{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:clamp(var(--space-5),3vw,var(--space-8));box-shadow:var(--shadow-sm)}
    .panel h2{font-family:var(--font-display);font-size:var(--text-lg);font-weight:400;margin-bottom:var(--space-4)}
    .stack{display:grid;gap:var(--space-4)}
    .timeline{display:grid;gap:var(--space-4)}
    .step{display:grid;grid-template-columns:auto 1fr;gap:var(--space-4);align-items:start;padding:var(--space-4);border-radius:var(--radius-md);background:var(--color-surface-2);border:1px solid var(--color-border)}
    .step-num{width:2.2rem;height:2.2rem;border-radius:50%;display:grid;place-items:center;background:var(--color-primary);color:#fff;font-weight:700;font-size:var(--text-sm);margin-top:.1rem}
    .step h3{font-size:var(--text-base);margin-bottom:var(--space-2)}
    .chip-row{display:flex;flex-wrap:wrap;gap:var(--space-2)}
    .chip{display:inline-flex;align-items:center;padding:var(--space-2) var(--space-3);border-radius:var(--radius-full);font-size:var(--text-xs);font-weight:600;background:var(--color-surface-offset);color:var(--color-text-muted);border:1px solid var(--color-border)}
    ul{padding-left:1.2rem}
    li+li{margin-top:var(--space-2)}
    .prompt-list li::marker{color:var(--color-primary)}
    .resource-links{display:grid;gap:var(--space-3)}
    .resource-links a{display:block;padding:var(--space-4);border-radius:var(--radius-md);background:var(--color-surface-2);border:1px solid var(--color-border);text-decoration:none;font-size:var(--text-sm)}
    .callout{border-left:4px solid var(--color-primary);padding:var(--space-4) var(--space-4) var(--space-4) var(--space-5);background:var(--color-primary-highlight);border-radius:var(--radius-md)}
    .deliverable{display:grid;gap:var(--space-3)}
    .deliverable-item{display:flex;gap:var(--space-3);align-items:flex-start;padding:var(--space-4);background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:var(--radius-md)}
    .deliverable-item .icon{flex:0 0 1.5rem;color:var(--color-success)}
    .footer-note{margin-top:var(--space-8);padding-top:var(--space-4);border-top:1px solid var(--color-divider);font-size:var(--text-sm);color:var(--color-text-muted)}
    @media (max-width: 520px){
      .hero-card,.panel,.step,.deliverable-item,.meta-card,.resource-links a{padding:var(--space-4)}
      .topbar-inner{padding:var(--space-3) 0}
      .step{grid-template-columns:1fr}
      .step-num{margin-top:0}
    }
    @media (prefers-reduced-motion: reduce){*{scroll-behavior:auto;transition:none!important}}
  </style>
</head>
<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <header class="topbar">
    <div class="shell topbar-inner">
      <a class="brand" href="#topo" aria-label="Ir para o início">
        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="32" cy="32" r="26" stroke="currentColor" stroke-width="4"/>
          <path d="M20 34c4-8 9-12 16-12 6 0 10 2 14 8" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
          <path d="M18 42c6-3 11-4 14-4 6 0 10 2 14 6" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
        </svg>
        <span>Planejamento de Aula</span>
      </a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Alternar tema">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
  </header>

  <main id="conteudo" class="shell">
    <section class="hero" id="topo">
      <div class="hero-card">
        <div class="eyebrow">Oficina de 90 minutos</div>
        <div class="stack">
          <h1>Validação da justificativa em projetos de extensão</h1>
          <p class="lead">Esta página organiza o planejamento da aula para que os estudantes revisem, testem e fortaleçam a justificativa de suas ações extensionistas, articulando escuta do público, dados e relevância social e acadêmica.</p>
        </div>
        <div class="meta" aria-label="Informações rápidas da oficina">
          <div class="meta-card"><strong>Foco</strong><span>Validar se o problema e a justificativa “se sustentam” diante da realidade do território.</span></div>
          <div class="meta-card"><strong>Resultado esperado</strong><span>Cada aluno sai com uma justificativa revisada e mais consistente.</span></div>
        </div>
      </div>
    </section>

    <section class="grid" aria-label="Planejamento principal da aula">
      <article class="panel">
        <h2>Objetivo da aula</h2>
        <p>Os estudantes devem sair da oficina com uma justificativa mais clara, mais convincente e mais bem fundamentada, capaz de demonstrar por que o problema importa para a sociedade e para a universidade.</p>
        <p>A validação, neste contexto, significa confrontar a justificativa com dados, escuta do público e critérios de relevância, em vez de tratá-la apenas como opinião ou formulação intuitiva.</p>

        <div class="callout" style="margin-top: var(--space-5);">
          <p><strong>Ideia central:</strong> a justificativa precisa mostrar que o problema existe, afeta um público real e mobiliza razões consistentes para a atuação extensionista da universidade.</p>
        </div>
      </article>

      <aside class="panel">
        <h2>Perguntas disparadoras</h2>
        <ul class="prompt-list">
          <li>O problema abordado apareceu de fato na escuta do público?</li>
          <li>O texto mostra por que ele importa para a comunidade?</li>
          <li>A justificativa está apoiada em dados, documentos ou referências confiáveis?</li>
          <li>O texto explica por que a universidade deve se envolver?</li>
        </ul>

        <div class="resource-links" style="margin-top: var(--space-5);">
          <a href="https://www.pucminas.br/institucional/Paginas/missao-e-valores.aspx" target="_blank" rel="noopener noreferrer">Missão e valores da PUC Minas</a>
          <a href="https://brasil.un.org/pt-br/sdgs" target="_blank" rel="noopener noreferrer">Objetivos de Desenvolvimento Sustentável</a>
        </div>
      </aside>
    </section>

    <section class="panel" style="margin-top: var(--space-6);">
      <h2>Roteiro da oficina</h2>
      <div class="timeline">
        <div class="step">
          <div class="step-num">1</div>
          <div>
            <h3>Releitura guiada — 15 min</h3>
            <p>Cada aluno elabora ou retoma a justificativa da sua ação extensionista, observando especialmente a evidência social do problema e a relevância acadêmica e extensionista da proposta.</p>
            <div class="chip-row" aria-label="Focos da etapa 1">
              <span class="chip">Evidência social</span>
              <span class="chip">Relevância acadêmica</span>
              <span class="chip">Base do problema</span>
            </div>
          </div>
        </div>

        <div class="step">
          <div class="step-num">2</div>
          <div>
            <h3>Escuta cruzada entre grupos — 20 min</h3>
            <p>Os alunos formam trios e trocam suas justificativas para avaliação mútua, verificando se o problema está descrito de forma concreta, se há evidências do impacto sobre o público e se a necessidade foi confirmada por dados, documentos ou escuta direta.</p>
            <ul>
              <li>O problema está descrito de forma concreta?</li>
              <li>Há evidências de que ele afeta esse público?</li>
              <li>Quem confirmou essa necessidade: dados, documentos ou escuta direta?</li>
              <li>Por que isso é relevante para a universidade e para a comunidade?</li>
            </ul>
          </div>
        </div>

        <div class="step">
          <div class="step-num">3</div>
          <div>
            <h3>Ajuste da justificativa — 25 min</h3>
            <p>Depois do retorno dos colegas, os alunos reescrevem a justificativa, revisando clareza do problema, base empírica ou documental, relevância social e relevância acadêmica e extensionista.</p>
            <div class="chip-row" aria-label="Critérios de revisão">
              <span class="chip">Clareza</span>
              <span class="chip">Base documental</span>
              <span class="chip">Relevância social</span>
              <span class="chip">Relevância extensionista</span>
            </div>
          </div>
        </div>

        <div class="step">
          <div class="step-num">4</div>
          <div>
            <h3>Fechamento e socialização — 20 min</h3>
            <p>Cada aluno expõe os principais desafios encontrados no processo e relata se conseguiu melhorar a construção da justificativa a partir da validação feita em aula.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="grid" style="margin-top: var(--space-6);">
      <article class="panel">
        <h2>Orientações ao professor</h2>
        <ul>
          <li>Estimule que os estudantes comparem suas justificativas com o que já foi produzido nas etapas anteriores do projeto, especialmente diagnóstico, escuta ativa e análise de relevância.</li>
          <li>Durante a escuta cruzada, incentive comentários objetivos, baseados em critérios, e não apenas opiniões genéricas sobre o texto.</li>
          <li>No fechamento, destaque que validar uma justificativa não é “embelezar” o texto, mas fortalecer seu vínculo com o território e com o papel da universidade.</li>
        </ul>
      </article>

      <aside class="panel">
        <h2>Produto da aula</h2>
        <div class="deliverable">
          <div class="deliverable-item">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <div>Um problema claramente formulado.</div>
          </div>
          <div class="deliverable-item">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <div>Uma evidência de relevância social.</div>
          </div>
          <div class="deliverable-item">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <div>Uma evidência de relevância acadêmica.</div>
          </div>
          <div class="deliverable-item">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <div>Uma frase final mostrando a importância da intervenção extensionista.</div>
          </div>
        </div>
      </aside>
    </section>

    <p class="footer-note">Planejamento organizado em formato de página responsiva para uso em aula e consulta em dispositivos móveis e computadores.</p>
  </main>

  <script>
    (function(){
      const root = document.documentElement;
      const toggle = document.querySelector('[data-theme-toggle]');
      let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      root.setAttribute('data-theme', theme);
      const renderIcon = () => {
        toggle.innerHTML = theme === 'dark'
          ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>'
          : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
        toggle.setAttribute('aria-label', theme === 'dark' ? 'Alternar para tema claro' : 'Alternar para tema escuro');
      };
      renderIcon();
      toggle.addEventListener('click', () => { theme = theme === 'dark' ? 'light' : 'dark'; root.setAttribute('data-theme', theme); renderIcon(); });
    })();
  </script>
</body>
</html>
